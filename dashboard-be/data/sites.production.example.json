{
  "sites": [
    {
      "site_id": "your-ecommerce-site",
      "name": "Your Ecommerce",
      "preview_base_url": "https://shop-preview.example.com",
      "api_base_url": "https://shop-api.example.com",
      "target_generation": {
        "mode": "hybrid",
        "source": "nav_scan",
        "seed_paths": ["/", "/shop", "/cart", "/checkout"],
        "include_patterns": ["/", "/shop", "/product", "/cart", "/checkout", "/collection"],
        "exclude_patterns": ["/login", "/join", "/mypage", "/board"],
        "max_targets": 6,
        "max_pages_to_scan": 6,
        "refresh_ttl_sec": 300
      },
      "preview_targets": [
        {
          "id": "home",
          "label": "홈",
          "path": "/",
          "url_prefix": "/",
          "default": true,
          "experiment_key": "exp_home_cta_v1"
        },
        {
          "id": "checkout",
          "label": "체크아웃",
          "path": "/checkout",
          "url_prefix": "/checkout",
          "experiment_key": "exp_checkout_cta_v1"
        }
      ]
    }
  ]
}
